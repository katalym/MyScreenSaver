// Version of MyScreenSaver. The numbers (VERCOMMA, VERSTR) are in MyScreenSaverBuild.inc, which build.bat writes:
// the first three numbers are VERBASE in build.bat, the last one is the number of commits of the Git repository.
// build.bat compiles this file into MyScreenSaverVersion.res (the Delphi IDE does it too).
#include "MyScreenSaverBuild.inc"
1 VERSIONINFO
FILEVERSION VERCOMMA
PRODUCTVERSION VERCOMMA
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "FileDescription", "MyScreenSaver"
      VALUE "FileVersion", VERSTR
      VALUE "InternalName", "MyScreenSaver"
      VALUE "OriginalFilename", "MyScreenSaver.exe"
      VALUE "ProductName", "MyScreenSaver"
      VALUE "ProductVersion", VERSTR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
