// Version of MyScreenSaver: change the numbers here BY HAND (FILEVERSION, PRODUCTVERSION and the two strings).
// brcc32 garbles a version string whose length (with the closing zero) is odd, that is a string with an EVEN number
// of characters, for example "3.0.0.10": then write "3.0.0.10\0" (an explicit zero at the end).
// build.bat compiles this file into MyScreenSaverVersion.res (the Delphi IDE does it too).
1 VERSIONINFO
FILEVERSION 3,0,0,2
PRODUCTVERSION 3,0,0,2
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "FileDescription", "MyScreenSaver"
      VALUE "FileVersion", "3.0.0.2"
      VALUE "InternalName", "MyScreenSaver"
      VALUE "OriginalFilename", "MyScreenSaver.exe"
      VALUE "ProductName", "MyScreenSaver"
      VALUE "ProductVersion", "3.0.0.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
