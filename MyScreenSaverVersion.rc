// Version of MyScreenSaver: change the numbers here (FILEVERSION, PRODUCTVERSION and the two strings).
// build.bat compiles this file into MyScreenSaverVersion.res (the Delphi IDE does it too).
1 VERSIONINFO
FILEVERSION 1,1,1,1
PRODUCTVERSION 1,1,1,1
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "FileDescription", "MyScreenSaver"
      VALUE "FileVersion", "1.1.1.1"
      VALUE "InternalName", "MyScreenSaver"
      VALUE "OriginalFilename", "MyScreenSaver.exe"
      VALUE "ProductName", "MyScreenSaver"
      VALUE "ProductVersion", "1.1.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
