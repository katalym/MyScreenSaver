@echo off
rem Builds MyScreenSaver.exe and MyScreenSaver.scr (Delphi 13, Win64) in this folder
setlocal
call "C:\Program Files (x86)\Embarcadero\Studio\37.0\bin\rsvars.bat"
pushd "%~dp0"
set OUT=%TEMP%\MyScreenSaver_win64
rem the version resource: MyScreenSaverVersion.rc -> MyScreenSaverVersion.res (the .res is committed too,
rem so the Delphi IDE can build without a resource compiler)
rem the version: VERBASE are the first three numbers. The last one (the build number) starts with 1 when the first
rem number of VERBASE changes and goes up by one for every commit that has changes of the code (see :version).
rem MyScreenSaverBuild.inc is written for the resource file; without git it stays as it is.
set VERBASE=3.0.0
call :version
brcc32 -fo MyScreenSaverVersion.res MyScreenSaverVersion.rc
if errorlevel 1 (popd & exit /b 1)
if not exist "%OUT%" mkdir "%OUT%"
rem MyScreenSaver.res (main icon, manifest) is generated from the dproj; dcc64 alone never refreshes it, so the
rem stale one is deleted and msbuild makes a new one and builds the exe
del MyScreenSaver.res 2>nul
msbuild MyScreenSaver.dproj /t:Build /p:Config=Release /p:Platform=Win64 /p:DCC_ExeOutput="%OUT%" /p:DCC_DcuOutput="%OUT%" /v:m /nologo
set ERR=%ERRORLEVEL%
if %ERR% neq 0 (popd & exit /b %ERR%)
copy /y "%OUT%\MyScreenSaver.exe" MyScreenSaver.exe >nul
copy /y "%OUT%\MyScreenSaver.exe" MyScreenSaver.scr >nul
popd
echo Built MyScreenSaver.exe and MyScreenSaver.scr (Win64) %VERBASE%.%BUILDNO%
goto :eof

rem The build number. MyScreenSaverBuild.inc keeps the state: the number, the first number of the version it belongs to
rem and the commit (HEAD) that was the last one when the number was raised.
rem - the first number of VERBASE is not the one of the file (or the file has no state): the number is 1;
rem - the code (pas, dpr, dfm, dproj, rc, bat) has changes that are not committed and HEAD is another commit than the
rem   recorded one (the previous commit has been made since): the number goes up by one, once for the next commit;
rem - otherwise the number stays (builds without changes of the code, or more builds before the same commit).
:version
set BUILDNO=
set OLDBASE=
set OLDHEAD=
set OLDNO=
for /f "tokens=2,3" %%a in ('findstr /b /c:"// verbase=" MyScreenSaverBuild.inc 2^>nul') do call :readmeta "%%a" "%%b"
for /f "tokens=3" %%v in ('findstr /b /c:"#define VERCOMMA" MyScreenSaverBuild.inc 2^>nul') do for /f "tokens=4 delims=," %%n in ("%%v") do set OLDNO=%%n
set NEWMAJOR=
set OLDMAJOR=
for /f "tokens=1 delims=." %%m in ("%VERBASE%") do set NEWMAJOR=%%m
if defined OLDBASE for /f "tokens=1 delims=." %%m in ("%OLDBASE%") do set OLDMAJOR=%%m
set HEADID=
for /f %%h in ('git rev-parse HEAD 2^>nul') do set HEADID=%%h
if not defined HEADID goto :eof
set PENDING=
for /f "delims=" %%s in ('git status --porcelain -- "*.pas" "*.dpr" "*.dfm" "*.dproj" "*.rc" "*.bat" 2^>nul') do set PENDING=1
set BUILDNO=%OLDNO%
set RECHEAD=%OLDHEAD%
if not "%OLDMAJOR%"=="%NEWMAJOR%" goto :reset
if not defined OLDNO goto :reset
if not defined PENDING goto :record
if "%OLDHEAD%"=="%HEADID%" goto :record
set /a BUILDNO=OLDNO+1
set RECHEAD=%HEADID%
goto :record
:reset
set BUILDNO=1
set RECHEAD=%HEADID%
:record
call :writeinc
goto :eof

rem %1 = verbase=3.0.0, %2 = head=<commit>
:readmeta
for /f "tokens=1,2 delims==" %%k in ("%~1") do set "OLDBASE=%%l"
for /f "tokens=1,2 delims==" %%k in ("%~2") do set "OLDHEAD=%%l"
goto :eof

rem brcc32 garbles a version string whose length with the closing zero is odd: then an explicit \0 is added
:writeinc
set "VERTEXT=%VERBASE%.%BUILDNO%"
set "RESTTEXT=%VERTEXT%"
set LEN=0
:lenloop
if not defined RESTTEXT goto lendone
set "RESTTEXT=%RESTTEXT:~1%"
set /a LEN+=1
goto lenloop
:lendone
set ZERO=
set /a ODD=LEN %% 2
if %ODD%==0 set ZERO=\0
> "%~dp0MyScreenSaverBuild.inc" echo // generated by build.bat (the build number: see :version in build.bat)
>> "%~dp0MyScreenSaverBuild.inc" echo // verbase=%VERBASE% head=%RECHEAD%
>> "%~dp0MyScreenSaverBuild.inc" echo #define VERCOMMA %VERBASE:.=,%,%BUILDNO%
>> "%~dp0MyScreenSaverBuild.inc" echo #define VERSTR "%VERTEXT%%ZERO%"
goto :eof
