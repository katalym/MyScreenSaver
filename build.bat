@echo off
rem Builds MyScreenSaver.exe and MyScreenSaver.scr (Delphi 13, Win64) in this folder
setlocal
call "C:\Program Files (x86)\Embarcadero\Studio\37.0\bin\rsvars.bat"
pushd "%~dp0"
set OUT=%TEMP%\MyScreenSaver_win64
rem the version resource: MyScreenSaverVersion.rc -> MyScreenSaverVersion.res (the .res is committed too,
rem so the Delphi IDE can build without a resource compiler)
rem the version: the first three numbers are VERBASE, the last one is the number of commits of the Git repository
rem (MyScreenSaverBuild.inc is written for the resource file; without git it stays as it is)
set VERBASE=2.0.0
set BUILDNO=
for /f %%c in ('git rev-list --count HEAD 2^>nul') do set BUILDNO=%%c
if defined BUILDNO call :writeinc
brcc32 -fo MyScreenSaverVersion.res MyScreenSaverVersion.rc
if errorlevel 1 (popd & exit /b 1)
if not exist "%OUT%" mkdir "%OUT%"
rem MyScreenSaver.res (main icon, manifest) is generated from the dproj; dcc64 alone never refreshes it, so the
rem stale one is deleted and msbuild makes a new one and builds the exe
del MyScreenSaver.res 2>nul
msbuild MyScreenSaver.dproj /t:Build /p:Config=Release /p:Platform=Win64 /p:DCC_ExeOutput="%OUT%" /p:DCC_DcuOutput="%OUT%" /v:m /nologo
set ERR=%ERRORLEVEL%
if %ERR% neq 0 (popd & exit /b %ERR%)
copy /y "%OUT%\MyScreenSaver.exe" MyScreenSaver.exe >nul
copy /y "%OUT%\MyScreenSaver.exe" MyScreenSaver.scr >nul
popd
echo Built MyScreenSaver.exe and MyScreenSaver.scr (Win64)
goto :eof

rem brcc32 garbles a version string whose length with the closing zero is odd: then an explicit \0 is added
:writeinc
set "VERTEXT=%VERBASE%.%BUILDNO%"
set "RESTTEXT=%VERTEXT%"
set LEN=0
:lenloop
if not defined RESTTEXT goto lendone
set "RESTTEXT=%RESTTEXT:~1%"
set /a LEN+=1
goto lenloop
:lendone
set ZERO=
set /a ODD=LEN %% 2
if %ODD%==0 set ZERO=\0
> "%~dp0MyScreenSaverBuild.inc" echo // generated by build.bat (the last number is the number of commits of the Git repository)
>> "%~dp0MyScreenSaverBuild.inc" echo #define VERCOMMA %VERBASE:.=,%,%BUILDNO%
>> "%~dp0MyScreenSaverBuild.inc" echo #define VERSTR "%VERTEXT%%ZERO%"
goto :eof